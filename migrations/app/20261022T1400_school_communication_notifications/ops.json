    ],
    "execute": [
      {
        "description": "create table \"Notification\"",
        "sql": "CREATE TABLE \"public\".\"Notification\" (\n  \"category\" text DEFAULT 'ANNOUNCEMENT' NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdByUserId\" int4,\n  \"id\" SERIAL NOT NULL,\n  \"message\" text NOT NULL,\n  \"scheduledAt\" timestamptz,\n  \"schoolId\" int4 NOT NULL,\n  \"sentAt\" timestamptz,\n  \"status\" text DEFAULT 'DRAFT' NOT NULL,\n  \"title\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Notification_category_check_c954437d\" CHECK (\"category\" IN ('FEE_REMINDER', 'REPORT_PUBLISHED', 'ACADEMIC', 'EVENT', 'ANNOUNCEMENT', 'URGENT')),\n  CONSTRAINT \"Notification_status_check_c5557860\" CHECK (\"status\" IN ('DRAFT', 'SCHEDULED', 'SENT', 'CANCELLED'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Notification\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"Notification\""
        ]
      }
    ]
  },
