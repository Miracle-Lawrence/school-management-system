// use prisma-8
enum UserRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  SCHOOL_OWNER
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssessmentType {
  ASSIGNMENT
  TEST
  CA
  EXAM
  PROJECT
  PRACTICAL
  OTHER
}

enum ReportType {
  MID_TERM
  TERMINAL
}

enum ReportComponentType {
  ASSESSMENT
  CALCULATED
}

enum AssessmentAggregationType {
  SUM
  AVERAGE
}

enum GradeCalculationType {
  PERCENTAGE
  RAW_SCORE
}

model School {
  id                       Int                        @id @default(autoincrement())
  name                     String
  slug                     String                     @unique
  email                    String?
  phone                    String?
  address                  String?
  city                     String?
  state                    String?
  country                  String                     @default("Nigeria")
  status                   SchoolStatus               @default(ACTIVE)
  users                    User[]
  students                 Student[]
  teachers                 Teacher[]
  parents                  Parent[]
  classes                  SchoolClass[]
  subjects                 Subject[]
  classSubjects            ClassSubject[]
  assessments              Assessment[]
  logoUrl                  String?
  faviconUrl               String?
  motto                    String?
  primaryColor             String?
  secondaryColor           String?
  accentColor              String?
  website                  String?
  principalName            String?
  principalTitle           String?
  stampUrl                 String?
  reportConfigurations     ReportConfiguration[]
  teacherAssignments       TeacherAssignment[]
  attendanceRecords        Attendance[]
  sessions                 AcademicSession[]
  gradeScales              GradeScale[]
  subjectResults           SubjectResult[]
  studentTermResults       StudentTermResult[]
  reportComments           ReportComment[]  

  psychomotorFields        PsychomotorField[]
  psychomotorRatingOptions PsychomotorRatingOption[]
  psychomotorRatings       StudentPsychomotorRating[]
  createdAt                TimestamptzString          @default(now())
  updatedAt                temporal.updatedAtString()
}

model ReportConfiguration {
  id         Int                        @id @default(autoincrement())

  school     School                     @relation(fields:[schoolId], references:[id])
  schoolId   Int

  reportType ReportType

  name       String
  isActive   Boolean                    @default(true)

  components ReportComponent[]

  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()

  @@unique([schoolId, reportType])
  @@index([schoolId])
}

model ReportComponent {
  id                Int                        @id @default(autoincrement())

  configuration     ReportConfiguration        @relation(fields:[configurationId], references:[id])
  configurationId   Int

  name              String
  type              ReportComponentType

  assessmentType    AssessmentType?

  rules             ReportComponentRule[]      @relation("ComponentRules")
  usedInRules       ReportComponentRule[]      @relation("RuleSourceComponent")
  resultScores      ResultComponentScore[]
  countsTowardTotal Boolean                    @default(true)
  aggregationType   AssessmentAggregationType  @default(SUM)

  maxScore          Float?
  weight            Float?

  displayOrder      Int
  isRequired        Boolean                    @default(true)
  isVisible         Boolean                    @default(true)

  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([configurationId, name])
  @@index([configurationId])
}

model ReportComponentRule {
  id                Int                        @id @default(autoincrement())

  component         ReportComponent            @relation("ComponentRules", fields:[componentId], references:[id])
  componentId       Int

  sourceComponent   ReportComponent            @relation("RuleSourceComponent", fields:[sourceComponentId], references:[id])
  sourceComponentId Int

  weight            Float?

  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([componentId, sourceComponentId])
  @@index([componentId])
  @@index([sourceComponentId])
}

model GradeScale {
  id           Int                        @id @default(autoincrement())

  school       School                     @relation(fields:[schoolId], references:[id])
  schoolId     Int

  name         String
  code         String
  minScore     Float
  maxScore     Float
  remark       String?
  displayOrder Int
  isActive     Boolean                    @default(true)

  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([schoolId, code])
  @@index([schoolId])
}

model PsychomotorField {
  id           Int                        @id @default(autoincrement())

  school       School                     @relation(fields:[schoolId], references:[id])
  schoolId     Int

  name         String
  description  String?
  displayOrder Int
  isActive     Boolean                    @default(true)

  ratings      StudentPsychomotorRating[]

  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([schoolId, name])
  @@index([schoolId])
}

model PsychomotorRatingOption {
  id           Int                        @id @default(autoincrement())

  school       School                     @relation(fields:[schoolId], references:[id])
  schoolId     Int

  label        String
  value        String
  displayOrder Int
  isActive     Boolean                    @default(true)

  ratings      StudentPsychomotorRating[]

  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([schoolId, value])
  @@index([schoolId])
}

model StudentPsychomotorRating {
  id        Int                        @id @default(autoincrement())

  school    School                     @relation(fields:[schoolId], references:[id])
  schoolId  Int

  student   Student                    @relation(fields:[studentId], references:[id])
  studentId Int

  term      Term                       @relation(fields:[termId], references:[id])
  termId    Int

  field     PsychomotorField           @relation(fields:[fieldId], references:[id])
  fieldId   Int

  rating    PsychomotorRatingOption    @relation(fields:[ratingId], references:[id])
  ratingId  Int

  comment   String?

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([studentId, termId, fieldId])
  @@index([schoolId])
  @@index([studentId])
  @@index([termId])
  @@index([fieldId])
  @@index([ratingId])
}

model SubjectResult {
  id              Int                        @id @default(autoincrement())

  school          School                     @relation(fields:[schoolId], references:[id])
  schoolId        Int

  student         Student                    @relation(fields:[studentId], references:[id])
  studentId       Int

  class           SchoolClass                @relation(fields:[classId], references:[id])
  classId         Int

  subject         Subject                    @relation(fields:[subjectId], references:[id])
  subjectId       Int

  term            Term                       @relation(fields:[termId], references:[id])
  termId          Int

  totalScore      Float
  percentageScore Float

  grade           String?
  remark          String?
  componentScores ResultComponentScore[]

  reportType      ReportType

  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()

  @@unique([studentId, subjectId, termId, reportType])
  @@index([schoolId])
  @@index([studentId])
  @@index([classId])
  @@index([subjectId])
  @@index([termId])
}

model ResultComponentScore {
  id              Int                        @id @default(autoincrement())

  subjectResult   SubjectResult              @relation(fields:[subjectResultId], references:[id])
  subjectResultId Int

  component       ReportComponent            @relation(fields:[componentId], references:[id])
  componentId     Int

  score           Float
  maxScore        Float?

  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()

  @@unique([subjectResultId, componentId])
  @@index([subjectResultId])
  @@index([componentId])
}

model StudentTermResult {
  id           Int                        @id @default(autoincrement())

  school       School                     @relation(fields:[schoolId], references:[id])
  schoolId     Int

  student      Student                    @relation(fields:[studentId], references:[id])
  studentId    Int

  class        SchoolClass                @relation(fields:[classId], references:[id])
  classId      Int

  term         Term                       @relation(fields:[termId], references:[id])
  termId       Int

  totalScore   Float
  averageScore Float

  position     Int?
  grade        String?
  remark       String?
  reportType   ReportType

  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([studentId, termId, reportType])
  @@index([schoolId])
  @@index([studentId])
  @@index([classId])
  @@index([termId])
}

model ReportComment {
  id               Int        @id @default(autoincrement())

  school           School     @relation(fields:[schoolId], references:[id])
  schoolId         Int

  student          Student    @relation(fields:[studentId], references:[id])
  studentId        Int

  term             Term       @relation(fields:[termId], references:[id])
  termId           Int

  reportType       ReportType

  teacherComment   String?
  principalComment String?

  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@unique([studentId, termId, reportType])
  @@index([schoolId])
  @@index([studentId])
  @@index([termId])
}

model User {
  id                 Int                        @id @default(autoincrement())
  school             School?                    @relation(fields:[schoolId], references:[id])
  schoolId           Int?
  email              String                     @unique
  passwordHash       String
  name               String?
  phone              String?
  role               UserRole
  isActive           Boolean                    @default(true)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  student            Student?
  teacher            Teacher?
  parent             Parent?
  createdAssessments Assessment[]               @relation("AssessmentCreatedBy")
  recordedAttendance Attendance[]               @relation("AttendanceRecordedBy")
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()
}

model Student {
  id                 Int                        @id @default(autoincrement())
  school             School                     @relation(fields:[schoolId], references:[id])
  schoolId           Int
  user               User?                      @relation(fields:[userId], references:[id])
  userId             Int?                       @unique
  admissionNumber    String
  firstName          String
  middleName         String?
  lastName           String
  gender             Gender
  dateOfBirth        DateTime?
  email              String?
  phone              String?
  address            String?
  photoUrl           String?
  class              SchoolClass?               @relation(fields:[classId], references:[id])
  classId            Int?
  parents            ParentStudent[]
  attendanceRecords  Attendance[]
  assessmentScores   AssessmentScore[]
  subjectResults     SubjectResult[]
  studentTermResults StudentTermResult[]
  psychomotorRatings StudentPsychomotorRating[]
  reportComments     ReportComment[]
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
}

model Teacher {
  id          Int                        @id @default(autoincrement())
  school      School                     @relation(fields:[schoolId], references:[id])
  schoolId    Int
  user        User?                      @relation(fields:[userId], references:[id])
  userId      Int?                       @unique
  employeeId  String
  firstName   String
  lastName    String
  phone       String?
  email       String?
  assignments TeacherAssignment[]
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([schoolId, employeeId])
  @@index([schoolId])
}

model Parent {
  id        Int                        @id @default(autoincrement())
  school    School                     @relation(fields:[schoolId], references:[id])
  schoolId  Int
  user      User?                      @relation(fields:[userId], references:[id])
  userId    Int?                       @unique
  firstName String
  lastName  String
  phone     String?
  email     String?
  address   String?
  children  ParentStudent[]
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@index([schoolId])
}

model ParentStudent {
  parent    Parent  @relation(fields:[parentId], references:[id])
  parentId  Int
  student   Student @relation(fields:[studentId], references:[id])
  studentId Int

  @@id([parentId, studentId])
}

model SchoolClass {
  id                 Int                        @id @default(autoincrement())
  school             School                     @relation(fields:[schoolId], references:[id])
  schoolId           Int
  name               String
  level              String?
  description        String?
  students           Student[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  attendanceRecords  Attendance[]
  assessments        Assessment[]
  subjectResults     SubjectResult[]
  studentTermResults StudentTermResult[]
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Subject {
  id                 Int                        @id @default(autoincrement())
  school             School                     @relation(fields:[schoolId], references:[id])
  schoolId           Int
  name               String
  code               String?
  description        String?
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  assessments        Assessment[]
  subjectResults     SubjectResult[]
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassSubject {
  id        Int                        @id @default(autoincrement())
  school    School                     @relation(fields:[schoolId], references:[id])
  schoolId  Int
  class     SchoolClass                @relation(fields:[classId], references:[id])
  classId   Int
  subject   Subject                    @relation(fields:[subjectId], references:[id])
  subjectId Int
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
}

model TeacherAssignment {
  id        Int                        @id @default(autoincrement())
  school    School                     @relation(fields:[schoolId], references:[id])
  schoolId  Int
  teacher   Teacher                    @relation(fields:[teacherId], references:[id])
  teacherId Int
  class     SchoolClass                @relation(fields:[classId], references:[id])
  classId   Int
  subject   Subject                    @relation(fields:[subjectId], references:[id])
  subjectId Int
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([teacherId, classId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
}

model AcademicSession {
  id        Int                        @id @default(autoincrement())
  school    School                     @relation(fields:[schoolId], references:[id])
  schoolId  Int
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean                    @default(false)
  terms     Term[]
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Term {
  id                 Int                        @id @default(autoincrement())
  session            AcademicSession            @relation(fields:[sessionId], references:[id])
  sessionId          Int
  name               String
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean                    @default(false)
  attendanceRecords  Attendance[]
  assessments        Assessment[]
  subjectResults     SubjectResult[]
  studentTermResults StudentTermResult[]
  psychomotorRatings StudentPsychomotorRating[]
  reportComments     ReportComment[]
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()

  @@unique([sessionId, name])
  @@index([sessionId])
}

model Assessment {
  id          Int                        @id @default(autoincrement())

  school      School                     @relation(fields:[schoolId], references:[id])
  schoolId    Int

  class       SchoolClass                @relation(fields:[classId], references:[id])
  classId     Int

  subject     Subject                    @relation(fields:[subjectId], references:[id])
  subjectId   Int

  term        Term                       @relation(fields:[termId], references:[id])
  termId      Int

  createdBy   User                       @relation("AssessmentCreatedBy", fields:[createdById], references:[id])
  createdById Int

  title       String
  type        AssessmentType
  maxScore    Float
  weight      Float
  date        DateTime?
  description String?

  scores      AssessmentScore[]

  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
  @@index([termId])
  @@index([createdById])
}

model AssessmentScore {
  id           Int                        @id @default(autoincrement())

  assessment   Assessment                 @relation(fields:[assessmentId], references:[id])
  assessmentId Int

  student      Student                    @relation(fields:[studentId], references:[id])
  studentId    Int

  score        Float
  remarks      String?

  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
}

model Attendance {
  id           Int                        @id @default(autoincrement())
  school       School                     @relation(fields:[schoolId], references:[id])
  schoolId     Int
  student      Student                    @relation(fields:[studentId], references:[id])
  studentId    Int
  class        SchoolClass                @relation(fields:[classId], references:[id])
  classId      Int
  term         Term                       @relation(fields:[termId], references:[id])
  termId       Int
  recordedBy   User                       @relation("AttendanceRecordedBy", fields:[recordedById], references:[id])
  recordedById Int
  date         DateTime
  status       AttendanceStatus
  notes        String?
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([studentId, date, classId])
  @@index([schoolId])
  @@index([studentId])
  @@index([classId])
  @@index([termId])
  @@index([date])
  @@index([recordedById])
}
